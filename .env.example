TG_BOT_TOKEN=

# Evidence enrichment (DataForSEO) — used by scripts/daily-research.mjs and scripts/enrich.mjs.
# Paid requests happen only when SCOUT_DFS_MODE=live AND credentials, cap and budget are set.
SCOUT_DFS_MODE=dry-run
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Must be the SAME cap the shared budget enforces (dataforseo_budget_settings); it can only lower it.
DATAFORSEO_MONTHLY_USD_CAP=
SCOUT_DFS_RESERVE_USD=1.00
SCOUT_DFS_MAX_RUN_USD=0.10

# Shared budget functions (db/dataforseo_budget.sql) on Career OS's Supabase.
# The anon key is the project's public key; the token is Scout's own client token
# (only its SHA-256 is stored in the database). No service-role key is needed.
DATAFORSEO_BUDGET_URL=
DATAFORSEO_BUDGET_ANON_KEY=
DATAFORSEO_BUDGET_TOKEN=

# Markets a plan may target ("Location:language; …"); the first is the default.
SCOUT_MARKETS=United States:en
# rpc (default, atomic) | legacy-ledger (pre-migration, supervised runs only)
SCOUT_BUDGET_BACKEND=rpc
SCOUT_ENRICH_MAX_IDEAS=3
