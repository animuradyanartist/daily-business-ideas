TG_BOT_TOKEN=

# Evidence enrichment (DataForSEO) — used by scripts/daily-research.mjs and scripts/enrich.mjs.
# Paid requests happen only when SCOUT_DFS_MODE=live AND credentials, cap and ledger are set.
SCOUT_DFS_MODE=dry-run
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Must be the SAME cap Career OS enforces — the allowance is shared, not per app.
DATAFORSEO_MONTHLY_USD_CAP=
SCOUT_DFS_RESERVE_USD=1.00
SCOUT_DFS_MAX_RUN_USD=0.10
# Shared spend ledger (Career OS Supabase runtime_events).
LEDGER_SUPABASE_URL=
LEDGER_SUPABASE_SERVICE_KEY=
LEDGER_PROJECT_ID=
SCOUT_MARKET_LOCATION=United States
SCOUT_MARKET_LANGUAGE=en
SCOUT_ENRICH_MAX_IDEAS=3
