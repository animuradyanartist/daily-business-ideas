TG_BOT_TOKEN=

# Evidence enrichment (DataForSEO) — used by scripts/daily-research.mjs and scripts/enrich.mjs.
# Paid requests happen only when SCOUT_DFS_MODE=live AND a monthly allowance is set.
SCOUT_DFS_MODE=dry-run
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Scout's OWN monthly DataForSEO allowance, accounted in evidence/budget/ (this repo).
# No default: unset = nothing is bought. It does not limit other users of the same account.
SCOUT_DFS_MONTHLY_USD_CAP=
SCOUT_DFS_MAX_RUN_USD=0.10
SCOUT_DFS_MAX_REQUEST_USD=0.10

# Markets a plan may target ("Location:language; …"); the first is the default.
SCOUT_MARKETS=United States:en
SCOUT_ENRICH_MAX_IDEAS=3
